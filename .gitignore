# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files. .env.example 만 예외 — 어떤 변수가 필요한지는 커밋돼야 알 수 있다
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude (machine-local)
.claude/settings.local.json

# bkit (machine-local runtime/logs; state/ is shared)
.bkit/runtime/
.bkit/audit/

# enrich 중간 산출물 (검수용, 커밋하지 않는다)
scripts/enrich-out.json
.bkit/snapshots/
.bkit/decisions/
