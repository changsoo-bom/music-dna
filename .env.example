# YouTube Data API v3 — https://console.cloud.google.com/apis/credentials
# 프로젝트에 "YouTube Data API v3" 사용 설정 후 API 키 발급.
# 키 제한은 "API 제한 → YouTube Data API v3" 로 건다.
# HTTP 리퍼러 제한은 서버 호출에 맞지 않는다.
#
# 서버 전용이다. NEXT_PUBLIC_ 접두사를 절대 붙이지 않는다.
YOUTUBE_API_KEY=

# AI Music Story 생성용 (MY DNA 페이지). 서버 전용.
# 아직 사용 안 함 — 실제로 붙일 때 채운다.
# ANTHROPIC_API_KEY=
